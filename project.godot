; Engine configuration file.
; Nastaveni projektu NEON WRECK.

config_version=5

[application]

config/name="NEON WRECK"
config/description="Arkadova zavodni hra: nocni mesto, demolice a zbrane."
run/main_scene="res://scenes/test_city.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
Graphics="*res://scripts/autoload/graphics.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/positional_shadow/atlas_size=8192
anti_aliasing/quality/msaa_3d=2
